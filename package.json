{
  "name": "neuromr-pro",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "phantoms": "uv run --project engine python scripts/make_phantoms.py",
    "trace": "uv run --project engine python scripts/trace.py",
    "engine:test": "uv run --project engine pytest engine/tests",
    "tokens": "node scripts/export-tokens.mjs",
    "tokens:check": "node scripts/export-tokens.mjs --check",
    "design:render": "node scripts/render-design-screens.mjs",
    "design:prototype-check": "node scripts/check-design-prototype.mjs",
    "desktop:dev": "pnpm --filter @neuromr/desktop dev",
    "desktop:build": "pnpm --filter @neuromr/desktop build",
    "desktop:smoke": "pnpm desktop:build && node apps/desktop/e2e/smoke.mjs",
    "design:text-check": "node scripts/check-design-text.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
